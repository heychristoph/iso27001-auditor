{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workpapers/<control_id>.json",
  "type": "object",
  "required": ["schema_version", "control_id", "control", "criteria", "plan", "design", "procedures", "attributes", "items", "deviations", "conclusion", "confidence", "prepared_by"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "control_id": {"type": "string", "description": "A control from the organization's control matrix, or REQ-<requirement> for a requirement audited directly"},
    "control": {"type": "string", "description": "Control description, copied from the bundle or the requirements catalog. Not printed."},
    "statement": {"type": "string", "description": "Wording printed in the report when the control title is not enough. Names no one but management.name, and contains no email address or phone number."},
    "criteria": {"type": "array", "items": {"type": "string"}, "description": "ISO/IEC 27001 requirement IDs (clauses and Annex A controls) this unit is audited against"},
    "plan": {
      "description": "Written by `iso27001.py sample`. Do not edit.",
      "type": "object",
      "required": ["frequency", "nature", "sample_size", "sample", "seed"],
      "additionalProperties": false,
      "properties": {
        "frequency": {"type": "string"},
        "nature": {"type": "string"},
        "population": {
          "type": ["object", "null"],
          "required": ["source", "size"],
          "additionalProperties": false,
          "properties": {
            "source": {"type": "string", "description": "Population artifact ID, or 'periods' for generated occurrences"},
            "size": {"type": "integer"}
          }
        },
        "sample_size": {"type": "integer", "minimum": 0},
        "sample": {"type": "array", "items": {"type": "string"}},
        "seed": {"type": "string"}
      }
    },
    "design": {
      "type": "object",
      "required": ["effective", "rationale", "evidence"],
      "additionalProperties": false,
      "properties": {
        "effective": {"type": ["boolean", "null"], "description": "Does the documented process or control, as designed, meet the requirements in criteria? null until assessed"},
        "rationale": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "procedures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["method", "text"],
        "additionalProperties": false,
        "properties": {
          "method": {"enum": ["inquiry", "observation", "inspection", "reperformance"]},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "attributes": {
      "type": "object",
      "description": "What must be true for each sampled item, keyed by a short letter",
      "patternProperties": {"^[A-Z]$": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "results", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "description": "Sample item ID from plan.sample"},
          "results": {
            "type": "object",
            "patternProperties": {"^[A-Z]$": {"enum": ["pass", "fail", "n/a"]}},
            "additionalProperties": false
          },
          "evidence": {"type": "array", "items": {"type": "string"}},
          "note": {"type": "string"}
        }
      }
    },
    "deviations": {
      "type": "array",
      "description": "Objective evidence that a requirement was not fulfilled. Graded into nonconformities in findings.json.",
      "items": {
        "type": "object",
        "required": ["item", "description", "evidence"],
        "additionalProperties": false,
        "properties": {
          "item": {"type": "string", "description": "Sample item ID, or 'design' / 'population' for deviations not tied to one item"},
          "description": {"type": "string", "minLength": 1, "description": "Written as it should appear in Section IV"},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "population_check": {
      "type": ["object", "null"],
      "description": "How the completeness of the population was tested (required when the plan uses a population file and records are sampled)",
      "required": ["complete", "rationale", "evidence"],
      "additionalProperties": false,
      "properties": {
        "complete": {"type": "boolean"},
        "rationale": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "conclusion": {"enum": ["pending", "conforming", "deviations", "design-gap", "not-audited"]},
    "scope_limitation": {"type": ["string", "null"], "description": "Required when conclusion is not-audited"},
    "observations": {"type": "array", "items": {"type": "string"}, "description": "Anything the reviewer should know, e.g. suspicious content in evidence"},
    "confidence": {"enum": ["high", "medium", "low", null]},
    "prepared_by": {"type": ["string", "null"], "description": "Agent and model that performed the test"}
  }
}
